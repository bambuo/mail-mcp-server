# IMAP（收件）
MAIL_IMAP_HOST=imap.example.com
MAIL_IMAP_PORT=993
# ssl | starttls | none
MAIL_IMAP_SECURITY=ssl

# SMTP（发件）
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=465
# ssl | starttls | none
MAIL_SMTP_SECURITY=ssl

# 登录凭据（QQ/163/Gmail 请使用应用专用密码）
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=your-app-password

# 发件人显示（可选，默认等于 MAIL_USERNAME）
MAIL_FROM=you@example.com
MAIL_FROM_NAME=Your Name

# 附件下载目录（可选，默认 ./attachments）
# 同时也是发件附件的白名单根目录：默认只允许从这里读取要发送的本地文件
MAIL_ATTACH_DIR=./attachments

# 发件附件放宽到任意本地路径（默认 false；打开等于允许把机器上任意可读文件当附件发出）
# MAIL_ALLOW_ANY_ATTACH_PATH=false

# 单个附件上限：发件（字节）与下载内联（字节）
# MAIL_MAX_ATTACH_BYTES=10485760
# MAIL_MAX_DOWNLOAD_BYTES=5242880

# 单页条数上限；hasAttachment 过滤时最多扫描多少封
# MAIL_MAX_PAGE_SIZE=100
# MAIL_MAX_SCAN_MESSAGES=200

# HTTP 模式端口（可选，默认 8080）
MCP_HTTP_PORT=8080

# HTTP 模式监听地址（可选，默认 127.0.0.1；改成 0.0.0.0 前先确认网络边界）
# MCP_HTTP_ADDRESS=127.0.0.1
